# Copy to .env and fill in. NEVER commit .env.
# Ứng dụng đang được kiểm thử (khớp tên thư mục trong applications/)
APP=odoo

# --- Nhiều môi trường cho cùng một ứng dụng ---
# environments/odoo.json CHỈ chứa TÊN biến (ví dụ ODOO_STAGING_A_URL). URL, tài khoản, mật khẩu, phiên bản kỳ vọng nằm ở ĐÂY.
# Mỗi môi trường có bộ biến RIÊNG; không dùng chung biến giữa hai môi trường. Chỉ điền môi trường bạn thực sự dùng; để trống = môi trường đó không dùng được.
# Chọn môi trường: npm run qa:env -- select --env=STAGING_A, rồi tự xác nhận: npm run qa:env -- confirm --env=STAGING_A --requirement=<REQ-ID>
#
# Mỗi ROLE là một cặp tài khoản riêng. accountant thuộc nhóm account.group_account_invoice (kế toán).
# Nếu chỉ có tài khoản Administrator thì có thể điền tạm, nhưng báo cáo sẽ ghi rõ "chạy bằng tài khoản quản trị
# nên chưa chứng minh hành vi của đúng vai trò kế toán".
# noaccess: tài khoản KHÔNG thuộc account.group_account_invoice nhưng xem được SO (cho TC-SO-004/005).
# KHÔNG điền tài khoản quản trị vào noaccess: framework tự phát hiện và BLOCKED test phân quyền thay vì cho kết quả sai.
# Để trống = TC-SO-004/005 ở trạng thái BLOCKED.
# *_VERSION: phiên bản ứng dụng KỲ VỌNG (khớp tiền tố, ví dụ 18.0). Bắt buộc: framework đối chiếu với phiên bản thực tế trước khi chạy.
# *_DB: tên database (tuỳ chọn; để phân biệt hai môi trường chung máy chủ).

# STAGING_A
ODOO_STAGING_A_URL=https://your-odoo-staging-a.example.com
ODOO_STAGING_A_DB=
ODOO_STAGING_A_VERSION=18.0
ODOO_STAGING_A_ACCOUNTANT_USER=
ODOO_STAGING_A_ACCOUNTANT_PASS=
ODOO_STAGING_A_NOACCESS_USER=
ODOO_STAGING_A_NOACCESS_PASS=

# STAGING_B
ODOO_STAGING_B_URL=
ODOO_STAGING_B_DB=
ODOO_STAGING_B_VERSION=
ODOO_STAGING_B_ACCOUNTANT_USER=
ODOO_STAGING_B_ACCOUNTANT_PASS=
ODOO_STAGING_B_NOACCESS_USER=
ODOO_STAGING_B_NOACCESS_PASS=

# UAT
ODOO_UAT_URL=
ODOO_UAT_DB=
ODOO_UAT_VERSION=
ODOO_UAT_ACCOUNTANT_USER=
ODOO_UAT_ACCOUNTANT_PASS=
ODOO_UAT_NOACCESS_USER=
ODOO_UAT_NOACCESS_PASS=

# --- Chính sách ghi/cleanup (xem mục policy trong environments/<app>.json và: npm run qa:policy -- show) ---
# AUTO_CLEANUP=false chỉ có thể TẮT cleanup tự động; không bật được từ đây (bật bằng policy.autoCleanup + người dùng xác nhận qa:policy confirm).
# AUTO_CLEANUP=false
# Danh sách host KHÔNG BAO GIỜ được ghi tự động (phân tách bằng dấu phẩy): thêm một lớp chặn production kể cả khi cấu hình sai.
# QA_PRODUCTION_HOSTS=erp.congty.com

# MẶC ĐỊNH false và NÊN GIỮ false trong .env.
# Test ghi dữ liệu (tạo SO, phiếu thu, bút toán) chỉ chạy khi bạn chủ động: npm run test:write
# (phải gõ lại tên host để xác nhận, riêng cho từng môi trường). Chỉ dùng trên môi trường test/staging, KHÔNG BAO GIỜ trên production.
ALLOW_WRITE_TESTS=false

# --- Browser ---
# chrome = Chrome cài sẵn trên máy; để trống = Chromium của Playwright
BROWSER_CHANNEL=chrome
HEADLESS=true
