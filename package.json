{
  "name": "qa-automation-framework",
  "version": "1.0.0",
  "description": "Requirement-driven, human-approved QA test automation framework (Playwright + TypeScript + Claude Code)",
  "type": "module",
  "scripts": {
    "test": "tsx scripts/run-tests.ts",
    "test:framework": "tsx scripts/run-tests.ts --framework",
    "test:odoo": "tsx scripts/run-tests.ts --project=odoo-sales",
    "typecheck": "tsc --noEmit",
    "report:rebuild": "tsx scripts/rebuild-report.ts",
    "new:app": "tsx scripts/scaffold.ts app",
    "new:module": "tsx scripts/scaffold.ts module",
    "cleanup:plan": "tsx scripts/cleanup-autotest.ts",
    "registry:backfill": "tsx scripts/registry-backfill.ts",
    "baseline:fields": "tsx scripts/snapshot-fields.ts",
    "requirements:lock": "tsx scripts/lock-requirements.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "security:scrub": "tsx scripts/scrub-traces.ts",
    "package:share": "tsx scripts/package-share.ts",
    "test:write": "tsx scripts/run-tests.ts --write",
    "req:import": "tsx scripts/req-import.ts",
    "req:check": "tsx scripts/req-check.ts",
    "req:verify": "tsx scripts/req-verify.ts",
    "qa:approval": "tsx scripts/approval.ts",
    "qa:env": "tsx scripts/environment.ts",
    "qa:review": "tsx scripts/review.ts",
    "qa:env-web": "tsx scripts/env-review.ts",
    "qa:policy": "tsx scripts/policy.ts",
    "cleanup:run": "tsx scripts/cleanup-run.ts",
    "odoo:probe": "tsx scripts/odoo-probe.ts",
    "qa:ready": "tsx scripts/ready.ts",
    "qa:next": "tsx scripts/next.ts",
    "setup": "tsx scripts/setup.ts",
    "qa:finish": "tsx scripts/qa-finish.ts",
    "report:verify": "tsx scripts/report-verify.ts",
    "package:template": "tsx scripts/package-share.ts --template"
  },
  "keywords": [
    "qa-automation",
    "playwright",
    "claude-code",
    "testing"
  ],
  "author": "info@moveoplus.com",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
