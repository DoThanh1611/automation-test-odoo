{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@core/*": [
        "./core/*"
      ],
      "@apps/*": [
        "./applications/*"
      ]
    }
  },
  "include": [
    "core",
    "applications",
    "tests",
    "playwright.config.ts",
    "scripts"
  ]
}
